        "/srv/wl-quality/evidence/backend"
      ],
      "reviewers": [
        "REPLACE_BACKEND_REVIEWER"
      ],
      "collectorConfigFile": "./review-collector.backend.json",
      "reviewPolicyFile": "./review-policy.backend.json",
      "reviewPolicyHash": "REPLACE_APPROVED_REVIEW_POLICY_SHA256",
      "policyHash": "REPLACE_APPROVED_GATE_POLICY_SHA256",
      "rulesHash": "REPLACE_APPROVED_RULES_SHA256",
      "baselineHash": "REPLACE_APPROVED_BASELINE_SHA256",
      "waiversHash": "REPLACE_APPROVED_WAIVERS_SHA256",
      "profile": "standard"
    }
  }
