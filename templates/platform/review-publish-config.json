{
  "schemaVersion": 1,
  "controlCatalogFile": "/srv/wl-quality/control/reviews.json",
  "authorizationDir": "/srv/wl-quality/control/authorizations",
  "stateFile": "/srv/wl-quality/review-signing/state.json",
  "manifestDir": "/srv/wl-quality/review-delivery",
  "reviewPrivateKeyEnv": "WL_REVIEW_PRIVATE_KEY_FILE",
