{
  "schemaVersion": 1,
  "project": "wl-produce",
  "ciConfigFile": "./ci-source.backend.json",
  "reviewPolicyHash": "REPLACE_APPROVED_REVIEW_POLICY_SHA256",
  "allowedAuthorIds": [
    "REPLACE_BACKEND_OWNER",
    "REPLACE_BACKEND_BACKUP",
    "REPLACE_BACKEND_DEVELOPER",
    "REPLACE_TEAM_LEAD"
  ],
  "evidence": [
    {
      "id": "submission",
      "type": "commit-check",
      "path": "quality-reports/review/submission.json",
      "dimensionIds": [
        "submission"
      ]
    },
    {
      "id": "branch",
      "type": "branch-check",
      "path": "quality-reports/review/branch.json",
      "dimensionIds": [
        "branch"
      ]
    },
    {
      "id": "tests",
      "type": "test-verification",
      "path": "quality-reports/review/tests.json",
      "dimensionIds": [
        "tests"
      ]
    },
    {
      "id": "diff",
      "type": "diff",
      "path": "quality-reports/review/diff.patch",
      "dimensionIds": [
        "coding",
        "review"
      ]
    },
    {
      "id": "impact-review",
      "type": "impact-review",
      "path": "quality-reports/review/impact-review.json",
      "dimensionIds": [
        "review"
      ]
    }
  ],
  "supplement": {
    "governanceConfigFile": "./governance-config.json",
    "authorizationPublicKeyFile": "/srv/wl-quality/config/identity-authorization-public.pem",
    "authorizationIssuer": "wl-quality-identity"
  }
}
