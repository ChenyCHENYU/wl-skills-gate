#!/bin/sh
if ! command -v node >/dev/null 2>&1; then
  echo "[quality] node 不可用：无法执行推送前检查（失败关闭，不跳过）"
  exit 2
fi
if [ ! -f "scripts/quality/run.mjs" ]; then
  echo "[quality] 缺少 scripts/quality/run.mjs：请复制 wl-skills-gate/templates/scripts-quality/run.mjs（失败关闭，不跳过）"
  exit 2
fi
node scripts/quality/run.mjs --profile standard
