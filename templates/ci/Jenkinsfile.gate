// Generated by Gate setup jenkins. The same protected entry serves CHECK/BUILD.
// __WL_BOOTSTRAP__
pipeline {
  agent { label '__WL_AGENT__' }
  options { skipDefaultCheckout(true); disableConcurrentBuilds() }
  parameters {
    string(name: 'WL_REVIEW_SHA', defaultValue: '', description: '受控续建传入；CHECK无需填写')
    string(name: 'WL_GATE_DISPATCH_ID', defaultValue: '', description: '自动续建追踪ID；不授予审核权限')
  }
  stages {
    stage('节点环境自检') {
      steps { script { wlGatePreflight(mode: 'job', gateRoot: '__WL_GATE_ROOT__', registry: '__WL_REGISTRY__') } }
    }
    stage('Gate') {
      steps {
        script {
          withEnv(["PATH+WLGATE=${env.WL_NODE_BIN_DIR ?: '/usr/bin'}"]) {
            load('__WL_GATE_ROOT__/templates/ci/jenkins-gate.groovy').call(
              gateRoot: '__WL_GATE_ROOT__', registry: '__WL_REGISTRY__')
          }
        }
      }
    }
  }
  post {
    unsuccessful { script { wlGateFailureNotice() } }
    always { archiveArtifacts artifacts: '.wl-gate-bootstrap/**', allowEmptyArchive: true }
  }
}
