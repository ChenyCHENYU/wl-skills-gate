// Controlled central job; enable a cron only after configuration and first run pass.
// Use this job OR the systemd automation loop. Never schedule both.
// __WL_BOOTSTRAP__
pipeline {
  agent { label '__WL_AGENT__' }
  options { disableConcurrentBuilds(); skipDefaultCheckout(true); timeout(time: 15, unit: 'MINUTES') }
  environment { WL_CENTRAL_AUTOMATION_CONFIG = '__WL_CENTRAL_CONFIG__/automation-config.json' }
  stages {
    stage('节点环境自检') {
      steps { script { wlGatePreflight(mode: 'automation', gateRoot: '__WL_GATE_ROOT__') } }
    }
    stage('采集、对账与通知') {
      steps {
        withEnv(['WL_APPROVED_GATE_CLI=__WL_GATE_ROOT__/bin/wl-skills-gate.js', 'WL_APPROVED_GATE_SETUP=__WL_GATE_ROOT__/bin/wl-quality-setup.js', "PATH+WLGATE=${env.WL_NODE_BIN_DIR ?: '/usr/bin'}"]) {
          withCredentials([
            string(credentialsId: 'wl-feishu-ci-webhook', variable: 'WL_FEISHU_CI_WEBHOOK'),
            string(credentialsId: 'wl-feishu-ci-signing-secret', variable: 'WL_FEISHU_CI_SECRET'),
            string(credentialsId: 'wl-feishu-project-webhook', variable: 'WL_FEISHU_PROJECT_WEBHOOK'),
            string(credentialsId: 'wl-feishu-project-signing-secret', variable: 'WL_FEISHU_PROJECT_SECRET'),
                usernamePassword(credentialsId: 'wl-jenkins-ci-readonly', usernameVariable: 'WL_JENKINS_READ_USER', passwordVariable: 'WL_JENKINS_READ_TOKEN'),
                string(credentialsId: 'wl-ci-review-readonly-token', variable: 'WL_GITLAB_READ_TOKEN'),
                usernamePassword(credentialsId: 'wl-jenkins-build-dispatch', usernameVariable: 'WL_JENKINS_BUILD_USER', passwordVariable: 'WL_JENKINS_BUILD_TOKEN'),
                string(credentialsId: 'wl-quality-sso-client-secret', variable: 'WL_SSO_CLIENT_SECRET')
          ]) {
            sh '''
              set -eu
              node "$WL_APPROVED_GATE_SETUP" central --config-dir "$(dirname "$WL_CENTRAL_AUTOMATION_CONFIG")" --send --separate-review-signer --json
              node "$WL_APPROVED_GATE_CLI" automation --config "$WL_CENTRAL_AUTOMATION_CONFIG" --send
            '''
          }
        }
      }
    }
  }
  post {
    unsuccessful { script { wlGateFailureNotice() } }
    always { archiveArtifacts artifacts: '.wl-gate-bootstrap/**', allowEmptyArchive: true }
  }
}
