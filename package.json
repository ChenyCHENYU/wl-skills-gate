{
  "name": "@agile-team/wl-skills-gate",
  "version": "0.9.0",
  "description": "质量工程执行包 — 统一接入、九维Review证据授权、自动门禁、可信CI采集与分类治理通知",
  "type": "module",
  "main": "./lib/run.js",
  "bin": {
    "wl-skills-gate": "bin/wl-skills-gate.js",
    "wl-gate": "bin/wl-skills-gate.js"
  },
  "scripts": {
    "test": "node --test scripts/lib-tests/*.test.mjs && node scripts/run-fixtures.mjs && node scripts/run-integration.mjs",
    "verify": "node --test scripts/lib-tests/*.test.mjs && node scripts/run-fixtures.mjs && node scripts/run-integration.mjs"
  },
  "files": [
    "assets/",
    "bin/",
    "lib/",
    "schemas/",
    "docs/",
    "templates/",
    "fixtures/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "quality-gate",
    "ci",
    "gitlab",
    "jenkins",
    "fail-closed",
    "agile-team"
  ],
  "author": "AGILE TEAM",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/wl-skills-gate.git"
  },
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/wl-skills-gate/issues"
  },
  "homepage": "https://github.com/ChenyCHENYU/wl-skills-gate#readme"
